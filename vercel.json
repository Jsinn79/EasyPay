{
  "version": 2,
  "buildCommand": "cd client && npm run build",
  "outputDirectory": "client/dist",
  "installCommand": "npm run install:all",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/favicon.svg", "destination": "/favicon.svg" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "memory": 256,
      "maxDuration": 10
    }
  }
}